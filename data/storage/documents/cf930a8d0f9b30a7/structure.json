      "chunks": [
        {
          "chunk_id": "chunk-1",
          "parent_section_id": "section-2",
          "text": "La biologia celular estudia la estructura y funcion de las celulas. La celula es la unidad basica de los seres vivos y contiene componentes especializados.",
          "order": 1,
          "start_line": 5,
          "end_line": 5,
