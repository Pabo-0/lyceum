SET n:Chunk
SET n += {character_count: 1917, chunk_source_id: "graph-chunk-1", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Este documento es una muestra extensa para evaluar la fase 2 del sistema de interpretacion de documentos. El tema elegido es Machine Learning porque combina definiciones formales, razonamiento matematico, tablas comparativas, procedimientos tecnicos y criterios pedagogicos que aparecen con frecuencia en materiales educativos reales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Machine Learning, o aprendizaje automatico, es una rama de la inteligencia artificial que estudia metodos capaces de mejorar su desempeno en una tarea a partir de datos. En lugar de programar reglas explicitas para cada caso, se define una familia de modelos, se proporciona evidencia en forma de ejemplos y se ajustan parametros para reducir una funcion de perdida.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En un curso introductorio, el objetivo no es memorizar algoritmos aislados, sino entender la estructura comun que comparten: un conjunto de datos, una representacion, una hipotesis, un criterio de evaluacion y un procedimiento de optimizacion. Esta estructura permite comparar modelos simples como regresion lineal con modelos mas flexibles como bosques aleatorios o redes neuronales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Al estudiar este documento, una persona deberia poder reconocer los elementos centrales de un flujo de trabajo de Machine Learning y explicar por que cada etapa afecta el desempeno final del sistema. La separacion por secciones busca que el grafo resultante refleje una progresion pedagogica clara.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Definir Machine Learning con precision conceptual. - Diferenciar aprendizaje supervisado, no supervisado y por refuerzo. - Interpretar funciones de perdida y metricas de evaluacion. - Reconocer riesgos como sobreajuste, fuga de informacion y sesgo de datos. - Comprender el papel de la validacion y la explicabilidad en entornos educativos.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El documento tambien incluye bloques Markdown que deben conservarse dentro de los chunks. La fase 2 debe mostrar tablas, formulas, listas, citas y codigo sin perder estructura visual.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Este documento es una muestra extensa para evaluar la fase 2 del sistema de interpretacion de documentos. El tema elegido es Machine Learning porque combina definiciones formales, razonamiento matematico, tablas comparativas, procedimientos tecnicos y criterios pedagogicos que aparecen con frecuencia en materiales educativos reales.\n\nMachine Learning, o aprendizaje automatico, es una rama de la inteligencia artificial que estudia metodos capaces de mejorar su desempeno en una tarea a partir de datos. En lugar de programar reglas explicitas para cada caso, se define una familia de modelos, se proporciona evidencia en forma de ejemplos y se ajustan parametros para reducir una funcion de perdida.\n\nEn un curso introductorio, el objetivo no es memorizar algoritmos aislados, sino entender la estructura comun que comparten: un conjunto de datos, una representacion, una hipotesis, un criterio de evaluacion y un procedimiento de optimizacion. Esta estructura permite comparar modelos simples como regresion lineal con modelos mas flexibles como bosques aleatorios o redes neuronales.\n\nAl estudiar este documento, una persona deberia poder reconocer los elementos centrales de un flujo de trabajo de Machine Learning y explicar por que cada etapa afecta el desempeno final del sistema. La separacion por secciones busca que el grafo resultante refleje una progresion pedagogica clara.\n\n- Definir Machine Learning con precision conceptual.\n- Diferenciar aprendizaje supervisado, no supervisado y por refuerzo.\n- Interpretar funciones de perdida y metricas de evaluacion.\n- Reconocer riesgos como sobreajuste, fuga de informacion y sesgo de datos.\n- Comprender el papel de la validacion y la explicabilidad en entornos educativos.\n\nEl documento tambien incluye bloques Markdown que deben conservarse dentro de los chunks. La fase 2 debe mostrar tablas, formulas, listas, citas y codigo sin perder estructura visual.", content_text: "Este documento es una muestra extensa para evaluar la fase 2 del sistema de interpretacion de documentos. El tema elegido es Machine Learning porque combina definiciones formales, razonamiento matematico, tablas comparativas, procedimientos tecnicos y criterios pedagogicos que aparecen con frecuencia en materiales educativos reales.\n\nMachine Learning, o aprendizaje automatico, es una rama de la inteligencia artificial que estudia metodos capaces de mejorar su desempeno en una tarea a partir de datos. En lugar de programar reglas explicitas para cada caso, se define una familia de modelos, se proporciona evidencia en forma de ejemplos y se ajustan parametros para reducir una funcion de perdida.\n\nEn un curso introductorio, el objetivo no es memorizar algoritmos aislados, sino entender la estructura comun que comparten: un conjunto de datos, una representacion, una hipotesis, un criterio de evaluacion y un procedimiento de optimizacion. Esta estructura permite comparar modelos simples como regresion lineal con modelos mas flexibles como bosques aleatorios o redes neuronales.\n\nAl estudiar este documento, una persona deberia poder reconocer los elementos centrales de un flujo de trabajo de Machine Learning y explicar por que cada etapa afecta el desempeno final del sistema. La separacion por secciones busca que el grafo resultante refleje una progresion pedagogica clara.\n\n- Definir Machine Learning con precision conceptual. - Diferenciar aprendizaje supervisado, no supervisado y por refuerzo. - Interpretar funciones de perdida y metricas de evaluacion. - Reconocer riesgos como sobreajuste, fuga de informacion y sesgo de datos. - Comprender el papel de la validacion y la explicabilidad en entornos educativos.\n\nEl documento tambien incluye bloques Markdown que deben conservarse dentro de los chunks. La fase 2 debe mostrar tablas, formulas, listas, citas y codigo sin perder estructura visual.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 21, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-1", node_type: "chunk", order: 1, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-1", source_chunk_ids: ["chunk-1", "chunk-2", "chunk-3", "chunk-4", "chunk-5", "chunk-6"], source_hash: "50563adb6dbb1f49f95e0d7b5c870f9505b0d6ac1c8950f66a9fae11ff68ee65", source_section_ids: ["section-2", "section-3"], source_section_titles: ["1. Proposito y contexto educativo", "1.1 Objetivos de aprendizaje"], start_position: 5, status: "active", title: "Machine learning", token_count: 365, visibility: "private", word_count: 276};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-2"})
SET n:Chunk
SET n += {character_count: 1906, chunk_source_id: "graph-chunk-2", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Una definicion clasica sostiene que un programa aprende de la experiencia `E` con respecto a una clase de tareas `T` y una medida de desempeno `P` si su desempeno en `T`, medido por `P`, mejora con la experiencia `E`. Esta formulacion es util porque separa tres preguntas: que tarea se resuelve, que datos alimentan el proceso y como se decide si hubo mejora.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En la practica, una tarea puede ser clasificar correos como deseados o no deseados, estimar el precio de una vivienda, recomendar ejercicios a un estudiante o detectar patrones en senales medicas. La experiencia suele representarse como un conjunto de observaciones con atributos, etiquetas, relaciones temporales o interacciones.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ ML = (T, E, P) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Donde `T` representa la tarea, `E` la experiencia disponible y `P` la medida de desempeno. Aunque la notacion es compacta, ayuda a evitar una confusion comun: un modelo no \\\"aprende\\\" de manera abstracta, aprende en relacion con una tarea concreta y una evaluacion definida.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Una tarea predictiva supervisada se puede describir mediante entradas `x`, salidas esperadas `y` y una funcion aproximadora `f_theta`. El subindice `theta` representa los parametros del modelo. Durante el entrenamiento, se busca un valor de `theta` que produzca predicciones cercanas a las etiquetas observadas.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Componente | Simbolo comun | Pregunta educativa | Ejemplo | | --- | --- | --- | --- | | Entrada | `x` | Que informacion recibe el modelo | horas de estudio, asistencia, puntajes previos | | Etiqueta | `y` | Que se desea predecir | resultado aprobado o no aprobado | | Modelo | `f_theta` | Que familia de funciones se ajusta | regresion logistica | | Perdida | `L` | Como se penalizan errores | entropia cruzada | | Metrica | `M` | Como se reporta desempeno | exactitud o F1 |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La tabla anterior debe permanecer como tabla Markdown. Si se aplana, se pierde la relacion entre simbolo, pregunta y ejemplo.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Una definicion clasica sostiene que un programa aprende de la experiencia `E` con respecto a una clase de tareas `T` y una medida de desempeno `P` si su desempeno en `T`, medido por `P`, mejora con la experiencia `E`. Esta formulacion es util porque separa tres preguntas: que tarea se resuelve, que datos alimentan el proceso y como se decide si hubo mejora.\n\nEn la practica, una tarea puede ser clasificar correos como deseados o no deseados, estimar el precio de una vivienda, recomendar ejercicios a un estudiante o detectar patrones en senales medicas. La experiencia suele representarse como un conjunto de observaciones con atributos, etiquetas, relaciones temporales o interacciones.\n\n$$\nML = (T, E, P)\n$$\n\nDonde `T` representa la tarea, `E` la experiencia disponible y `P` la medida de desempeno. Aunque la notacion es compacta, ayuda a evitar una confusion comun: un modelo no \"aprende\" de manera abstracta, aprende en relacion con una tarea concreta y una evaluacion definida.\n\nUna tarea predictiva supervisada se puede describir mediante entradas `x`, salidas esperadas `y` y una funcion aproximadora `f_theta`. El subindice `theta` representa los parametros del modelo. Durante el entrenamiento, se busca un valor de `theta` que produzca predicciones cercanas a las etiquetas observadas.\n\n| Componente | Simbolo comun | Pregunta educativa | Ejemplo |\n| --- | --- | --- | --- |\n| Entrada | `x` | Que informacion recibe el modelo | horas de estudio, asistencia, puntajes previos |\n| Etiqueta | `y` | Que se desea predecir | resultado aprobado o no aprobado |\n| Modelo | `f_theta` | Que familia de funciones se ajusta | regresion logistica |\n| Perdida | `L` | Como se penalizan errores | entropia cruzada |\n| Metrica | `M` | Como se reporta desempeno | exactitud o F1 |\n\nLa tabla anterior debe permanecer como tabla Markdown. Si se aplana, se pierde la relacion entre simbolo, pregunta y ejemplo.", content_text: "Una definicion clasica sostiene que un programa aprende de la experiencia `E` con respecto a una clase de tareas `T` y una medida de desempeno `P` si su desempeno en `T`, medido por `P`, mejora con la experiencia `E`. Esta formulacion es util porque separa tres preguntas: que tarea se resuelve, que datos alimentan el proceso y como se decide si hubo mejora.\n\nEn la practica, una tarea puede ser clasificar correos como deseados o no deseados, estimar el precio de una vivienda, recomendar ejercicios a un estudiante o detectar patrones en senales medicas. La experiencia suele representarse como un conjunto de observaciones con atributos, etiquetas, relaciones temporales o interacciones.\n\n$$ ML = (T, E, P) $$\n\nDonde `T` representa la tarea, `E` la experiencia disponible y `P` la medida de desempeno. Aunque la notacion es compacta, ayuda a evitar una confusion comun: un modelo no \"aprende\" de manera abstracta, aprende en relacion con una tarea concreta y una evaluacion definida.\n\nUna tarea predictiva supervisada se puede describir mediante entradas `x`, salidas esperadas `y` y una funcion aproximadora `f_theta`. El subindice `theta` representa los parametros del modelo. Durante el entrenamiento, se busca un valor de `theta` que produzca predicciones cercanas a las etiquetas observadas.\n\n| Componente | Simbolo comun | Pregunta educativa | Ejemplo | | --- | --- | --- | --- | | Entrada | `x` | Que informacion recibe el modelo | horas de estudio, asistencia, puntajes previos | | Etiqueta | `y` | Que se desea predecir | resultado aprobado o no aprobado | | Modelo | `f_theta` | Que familia de funciones se ajusta | regresion logistica | | Perdida | `L` | Como se penalizan errores | entropia cruzada | | Metrica | `M` | Como se reporta desempeno | exactitud o F1 |\n\nLa tabla anterior debe permanecer como tabla Markdown. Si se aplana, se pierde la relacion entre simbolo, pregunta y ejemplo.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 47, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-2", node_type: "chunk", order: 2, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-1", source_chunk_ids: ["chunk-7", "chunk-8", "chunk-9", "chunk-10", "chunk-11", "chunk-12", "chunk-13"], source_hash: "26485037b12a9ca534a0d415ba0b5f9081eb19144413ad2242893c6249393940", source_section_ids: ["section-4", "section-5"], source_section_titles: ["2. Definicion formal de Machine Learning", "2.1 Componentes de una tarea predictiva"], start_position: 25, status: "active", title: "Medida desempeno", token_count: 416, visibility: "private", word_count: 280};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-3"})
SET n:Chunk
SET n += {character_count: 1854, chunk_source_id: "graph-chunk-3", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Los datos son la materia prima del aprendizaje automatico. Sin embargo, no basta con acumular muchos registros. La calidad de los datos depende de su pertinencia, cobertura, consistencia, temporalidad y relacion con la tarea. Un conjunto de datos grande pero sesgado puede producir un modelo convincente en apariencia y deficiente en situaciones reales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En educacion, los datos pueden provenir de plataformas de aprendizaje, evaluaciones, interacciones con materiales, registros de asistencia o respuestas abiertas. Cada fuente introduce supuestos. Por ejemplo, el tiempo en pantalla no siempre significa atencion, y un puntaje bajo no siempre indica falta de comprension; puede reflejar ansiedad, ambiguedad en la pregunta o falta de acceso a recursos.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La representacion transforma observaciones del mundo en variables que un algoritmo puede procesar. Algunas variables son numericas, otras categoricas, ordinales, textuales o temporales. El diseno de esta representacion influye de manera directa en lo que el modelo puede aprender.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Tipo de variable | Descripcion | Transformacion frecuente | Riesgo comun | | --- | --- | --- | --- | | Numerica continua | Valores medidos en escala | normalizacion o estandarizacion | unidades inconsistentes | | Categorica nominal | Clases sin orden natural | one-hot encoding | categorias raras o nuevas | | Ordinal | Categorias con orden | codificacion ordinal | asumir distancias falsas | | Texto | Secuencias de palabras | bolsa de palabras, embeddings | perdida de contexto | | Temporal | Eventos ordenados | ventanas, rezagos, tendencias | fuga de informacion futura |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Una representacion adecuada no solo mejora la precision; tambien facilita interpretar errores. Cuando las variables se documentan con claridad, un docente o analista puede entender por que un modelo falla en ciertos grupos o situaciones.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Los datos son la materia prima del aprendizaje automatico. Sin embargo, no basta con acumular muchos registros. La calidad de los datos depende de su pertinencia, cobertura, consistencia, temporalidad y relacion con la tarea. Un conjunto de datos grande pero sesgado puede producir un modelo convincente en apariencia y deficiente en situaciones reales.\n\nEn educacion, los datos pueden provenir de plataformas de aprendizaje, evaluaciones, interacciones con materiales, registros de asistencia o respuestas abiertas. Cada fuente introduce supuestos. Por ejemplo, el tiempo en pantalla no siempre significa atencion, y un puntaje bajo no siempre indica falta de comprension; puede reflejar ansiedad, ambiguedad en la pregunta o falta de acceso a recursos.\n\nLa representacion transforma observaciones del mundo en variables que un algoritmo puede procesar. Algunas variables son numericas, otras categoricas, ordinales, textuales o temporales. El diseno de esta representacion influye de manera directa en lo que el modelo puede aprender.\n\n| Tipo de variable | Descripcion | Transformacion frecuente | Riesgo comun |\n| --- | --- | --- | --- |\n| Numerica continua | Valores medidos en escala | normalizacion o estandarizacion | unidades inconsistentes |\n| Categorica nominal | Clases sin orden natural | one-hot encoding | categorias raras o nuevas |\n| Ordinal | Categorias con orden | codificacion ordinal | asumir distancias falsas |\n| Texto | Secuencias de palabras | bolsa de palabras, embeddings | perdida de contexto |\n| Temporal | Eventos ordenados | ventanas, rezagos, tendencias | fuga de informacion futura |\n\nUna representacion adecuada no solo mejora la precision; tambien facilita interpretar errores. Cuando las variables se documentan con claridad, un docente o analista puede entender por que un modelo falla en ciertos grupos o situaciones.", content_text: "Los datos son la materia prima del aprendizaje automatico. Sin embargo, no basta con acumular muchos registros. La calidad de los datos depende de su pertinencia, cobertura, consistencia, temporalidad y relacion con la tarea. Un conjunto de datos grande pero sesgado puede producir un modelo convincente en apariencia y deficiente en situaciones reales.\n\nEn educacion, los datos pueden provenir de plataformas de aprendizaje, evaluaciones, interacciones con materiales, registros de asistencia o respuestas abiertas. Cada fuente introduce supuestos. Por ejemplo, el tiempo en pantalla no siempre significa atencion, y un puntaje bajo no siempre indica falta de comprension; puede reflejar ansiedad, ambiguedad en la pregunta o falta de acceso a recursos.\n\nLa representacion transforma observaciones del mundo en variables que un algoritmo puede procesar. Algunas variables son numericas, otras categoricas, ordinales, textuales o temporales. El diseno de esta representacion influye de manera directa en lo que el modelo puede aprender.\n\n| Tipo de variable | Descripcion | Transformacion frecuente | Riesgo comun | | --- | --- | --- | --- | | Numerica continua | Valores medidos en escala | normalizacion o estandarizacion | unidades inconsistentes | | Categorica nominal | Clases sin orden natural | one-hot encoding | categorias raras o nuevas | | Ordinal | Categorias con orden | codificacion ordinal | asumir distancias falsas | | Texto | Secuencias de palabras | bolsa de palabras, embeddings | perdida de contexto | | Temporal | Eventos ordenados | ventanas, rezagos, tendencias | fuga de informacion futura |\n\nUna representacion adecuada no solo mejora la precision; tambien facilita interpretar errores. Cuando las variables se documentan con claridad, un docente o analista puede entender por que un modelo falla en ciertos grupos o situaciones.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 67, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-3", node_type: "chunk", order: 3, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-1", source_chunk_ids: ["chunk-14", "chunk-15", "chunk-16", "chunk-17", "chunk-18"], source_hash: "0956ad596d1fff122c6ce3bdac30ac5cc8d9c7a5bd61a20b284ab67975c45337", source_section_ids: ["section-6", "section-7"], source_section_titles: ["3. Datos, representacion y calidad", "3.1 Tipos de variables"], start_position: 51, status: "active", title: "No siempre", token_count: 369, visibility: "private", word_count: 245};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-4"})
SET n:Chunk
SET n += {character_count: 853, chunk_source_id: "graph-chunk-4", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"La preparacion de datos incluye detectar valores faltantes, corregir formatos, eliminar duplicados, revisar outliers y separar conjuntos de entrenamiento, validacion y prueba. Esta etapa suele ocupar una gran parte del trabajo aplicado porque los modelos son sensibles a detalles aparentemente pequenos.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Puntos clave para una preparacion responsable:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Registrar las reglas de limpieza usadas. - Evitar usar informacion del conjunto de prueba durante el entrenamiento. - Documentar variables eliminadas y la razon de eliminacion. - Conservar versiones de datos y codigo de preparacion. - Revisar si los datos representan adecuadamente a la poblacion objetivo.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"> En Machine Learning educativo, preparar datos no es una tarea mecanica. Es una decision pedagogica y etica porque determina que aspectos del aprendizaje se vuelven visibles para el modelo.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "La preparacion de datos incluye detectar valores faltantes, corregir formatos, eliminar duplicados, revisar outliers y separar conjuntos de entrenamiento, validacion y prueba. Esta etapa suele ocupar una gran parte del trabajo aplicado porque los modelos son sensibles a detalles aparentemente pequenos.\n\nPuntos clave para una preparacion responsable:\n\n- Registrar las reglas de limpieza usadas.\n- Evitar usar informacion del conjunto de prueba durante el entrenamiento.\n- Documentar variables eliminadas y la razon de eliminacion.\n- Conservar versiones de datos y codigo de preparacion.\n- Revisar si los datos representan adecuadamente a la poblacion objetivo.\n\n> En Machine Learning educativo, preparar datos no es una tarea mecanica. Es una decision pedagogica y etica porque determina que aspectos del aprendizaje se vuelven visibles para el modelo.", content_text: "La preparacion de datos incluye detectar valores faltantes, corregir formatos, eliminar duplicados, revisar outliers y separar conjuntos de entrenamiento, validacion y prueba. Esta etapa suele ocupar una gran parte del trabajo aplicado porque los modelos son sensibles a detalles aparentemente pequenos.\n\nPuntos clave para una preparacion responsable:\n\n- Registrar las reglas de limpieza usadas. - Evitar usar informacion del conjunto de prueba durante el entrenamiento. - Documentar variables eliminadas y la razon de eliminacion. - Conservar versiones de datos y codigo de preparacion. - Revisar si los datos representan adecuadamente a la poblacion objetivo.\n\n> En Machine Learning educativo, preparar datos no es una tarea mecanica. Es una decision pedagogica y etica porque determina que aspectos del aprendizaje se vuelven visibles para el modelo.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 81, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-4", node_type: "chunk", order: 4, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-1", source_chunk_ids: ["chunk-19", "chunk-20", "chunk-21", "chunk-22"], source_hash: "d151dec6f119573ec98361f6a7a87d588ec53e77c379e7f19152d684a18a6a39", source_section_ids: ["section-8"], source_section_titles: ["3.2 Limpieza y preparacion"], start_position: 71, status: "active", title: "Preparacion datos", token_count: 161, visibility: "private", word_count: 118};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-5"})
SET n:Chunk
SET n += {character_count: 1689, chunk_source_id: "graph-chunk-5", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"El aprendizaje supervisado utiliza ejemplos en los que se conoce la respuesta esperada. El algoritmo recibe pares `(x_i, y_i)` y busca una funcion que generalice a casos nuevos. Dos tareas supervisadas frecuentes son clasificacion y regresion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En clasificacion, la salida pertenece a un conjunto discreto de clases. Por ejemplo, predecir si una respuesta escrita muestra comprension conceptual, error procedimental o ausencia de evidencia. En regresion, la salida es numerica, como estimar el tiempo necesario para completar una unidad o el puntaje esperado en una evaluacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La regresion lineal modela la relacion entre variables de entrada y una salida continua mediante una combinacion ponderada de atributos. Aunque es simple, sigue siendo importante porque ofrece una base conceptual para entender parametros, perdida y optimizacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ \\\\hat{y} = w_0 + w_1x_1 + w_2x_2 + \\\\cdots + w_px_p $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La prediccion `\\\\hat{y}` se obtiene sumando una interseccion `w_0` y productos entre pesos `w_j` y atributos `x_j`. Si el objetivo es minimizar error cuadratico medio, la perdida para `n` observaciones puede escribirse asi:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ MSE = \\\\frac{1}{n}\\\\sum_{i=1}^{n}(y_i - \\\\hat{y}_i)^2 $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En el aula, esta formula permite discutir por que errores grandes pesan mas que errores pequenos. Tambien permite mostrar que una metrica aparentemente tecnica contiene una decision: penalizar de manera cuadratica.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La regresion logistica se usa con frecuencia para clasificacion binaria. A pesar de su nombre, no predice una cantidad continua sin restricciones, sino una probabilidad entre 0 y 1. Esto se logra aplicando la funcion sigmoide a una combinacion lineal.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ \\\\sigma(z) = \\\\frac{1}{1 + e^{-z}} $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "El aprendizaje supervisado utiliza ejemplos en los que se conoce la respuesta esperada. El algoritmo recibe pares `(x_i, y_i)` y busca una funcion que generalice a casos nuevos. Dos tareas supervisadas frecuentes son clasificacion y regresion.\n\nEn clasificacion, la salida pertenece a un conjunto discreto de clases. Por ejemplo, predecir si una respuesta escrita muestra comprension conceptual, error procedimental o ausencia de evidencia. En regresion, la salida es numerica, como estimar el tiempo necesario para completar una unidad o el puntaje esperado en una evaluacion.\n\nLa regresion lineal modela la relacion entre variables de entrada y una salida continua mediante una combinacion ponderada de atributos. Aunque es simple, sigue siendo importante porque ofrece una base conceptual para entender parametros, perdida y optimizacion.\n\n$$\n\\hat{y} = w_0 + w_1x_1 + w_2x_2 + \\cdots + w_px_p\n$$\n\nLa prediccion `\\hat{y}` se obtiene sumando una interseccion `w_0` y productos entre pesos `w_j` y atributos `x_j`. Si el objetivo es minimizar error cuadratico medio, la perdida para `n` observaciones puede escribirse asi:\n\n$$\nMSE = \\frac{1}{n}\\sum_{i=1}^{n}(y_i - \\hat{y}_i)^2\n$$\n\nEn el aula, esta formula permite discutir por que errores grandes pesan mas que errores pequenos. Tambien permite mostrar que una metrica aparentemente tecnica contiene una decision: penalizar de manera cuadratica.\n\nLa regresion logistica se usa con frecuencia para clasificacion binaria. A pesar de su nombre, no predice una cantidad continua sin restricciones, sino una probabilidad entre 0 y 1. Esto se logra aplicando la funcion sigmoide a una combinacion lineal.\n\n$$\n\\sigma(z) = \\frac{1}{1 + e^{-z}}\n$$", content_text: "El aprendizaje supervisado utiliza ejemplos en los que se conoce la respuesta esperada. El algoritmo recibe pares `(x_i, y_i)` y busca una funcion que generalice a casos nuevos. Dos tareas supervisadas frecuentes son clasificacion y regresion.\n\nEn clasificacion, la salida pertenece a un conjunto discreto de clases. Por ejemplo, predecir si una respuesta escrita muestra comprension conceptual, error procedimental o ausencia de evidencia. En regresion, la salida es numerica, como estimar el tiempo necesario para completar una unidad o el puntaje esperado en una evaluacion.\n\nLa regresion lineal modela la relacion entre variables de entrada y una salida continua mediante una combinacion ponderada de atributos. Aunque es simple, sigue siendo importante porque ofrece una base conceptual para entender parametros, perdida y optimizacion.\n\n$$ \\hat{y} = w_0 + w_1x_1 + w_2x_2 + \\cdots + w_px_p $$\n\nLa prediccion `\\hat{y}` se obtiene sumando una interseccion `w_0` y productos entre pesos `w_j` y atributos `x_j`. Si el objetivo es minimizar error cuadratico medio, la perdida para `n` observaciones puede escribirse asi:\n\n$$ MSE = \\frac{1}{n}\\sum_{i=1}^{n}(y_i - \\hat{y}_i)^2 $$\n\nEn el aula, esta formula permite discutir por que errores grandes pesan mas que errores pequenos. Tambien permite mostrar que una metrica aparentemente tecnica contiene una decision: penalizar de manera cuadratica.\n\nLa regresion logistica se usa con frecuencia para clasificacion binaria. A pesar de su nombre, no predice una cantidad continua sin restricciones, sino una probabilidad entre 0 y 1. Esto se logra aplicando la funcion sigmoide a una combinacion lineal.\n\n$$ \\sigma(z) = \\frac{1}{1 + e^{-z}} $$", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 111, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-5", node_type: "chunk", order: 5, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-2", source_chunk_ids: ["chunk-23", "chunk-24", "chunk-25", "chunk-26", "chunk-27", "chunk-28", "chunk-29", "chunk-30", "chunk-31"], source_hash: "0e1a77c94f7b903c7113c129a97b363cd0843cb5176bb8ed3d838fc8d1a9475b", source_section_ids: ["section-9", "section-10", "section-11"], source_section_titles: ["4. Aprendizaje supervisado", "4.1 Regresion lineal", "4.2 Regresion logistica"], start_position: 85, status: "active", title: "Aprendizaje supervisado utiliza", token_count: 328, visibility: "private", word_count: 267};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-6"})
SET n:Chunk
SET n += {character_count: 1872, chunk_source_id: "graph-chunk-6", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"La salida se interpreta como `P(y = 1 | x)`. En un contexto educativo, podria estimar la probabilidad de que un estudiante necesite apoyo adicional en un tema. Esa probabilidad no debe confundirse con una etiqueta definitiva. La decision final depende de un umbral, del costo de falsos positivos y falsos negativos, y de la intervencion disponible.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Un arbol de decision divide el espacio de atributos mediante reglas simples. Cada nodo interno plantea una condicion y cada hoja produce una prediccion. Su atractivo pedagogico es que permite visualizar una secuencia de decisiones.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Ejemplo simplificado:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"```text si dominio_de_prerrequisitos < 0.50: recomendar repaso guiado si no, si practica_reciente < 3 sesiones: recomendar ejercicios graduados si no: recomendar desafio aplicado ```\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Aunque los arboles son interpretables, pueden sobreajustarse si crecen sin restricciones. Por eso suelen limitarse con profundidad maxima, numero minimo de muestras por hoja o poda posterior.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El aprendizaje no supervisado busca estructura en datos sin etiquetas explicitas. No intenta predecir una respuesta conocida, sino descubrir agrupamientos, dimensiones latentes o patrones frecuentes. Esto es util cuando se quiere explorar una poblacion de estudiantes o materiales sin imponer categorias previas.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El agrupamiento, o clustering, asigna observaciones a grupos segun similitud. Un ejemplo clasico es `k-means`, que busca `k` centroides y asigna cada punto al centro mas cercano.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ J = \\\\sum_{i=1}^{n} \\\\min_{c \\\\in \\\\{1,\\\\dots,k\\\\}} ||x_i - \\\\mu_c||^2 $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La formula expresa que se minimiza la distancia de cada punto al centroide de su grupo. En educacion, el agrupamiento puede revelar perfiles de interaccion, como estudiantes que consultan teoria antes de practicar, estudiantes que saltan directo a ejercicios o estudiantes que repiten intentos sin revisar retroalimentacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "La salida se interpreta como `P(y = 1 | x)`. En un contexto educativo, podria estimar la probabilidad de que un estudiante necesite apoyo adicional en un tema. Esa probabilidad no debe confundirse con una etiqueta definitiva. La decision final depende de un umbral, del costo de falsos positivos y falsos negativos, y de la intervencion disponible.\n\nUn arbol de decision divide el espacio de atributos mediante reglas simples. Cada nodo interno plantea una condicion y cada hoja produce una prediccion. Su atractivo pedagogico es que permite visualizar una secuencia de decisiones.\n\nEjemplo simplificado:\n\n```text\nsi dominio_de_prerrequisitos < 0.50:\nrecomendar repaso guiado\nsi no, si practica_reciente < 3 sesiones:\nrecomendar ejercicios graduados\nsi no:\nrecomendar desafio aplicado\n```\n\nAunque los arboles son interpretables, pueden sobreajustarse si crecen sin restricciones. Por eso suelen limitarse con profundidad maxima, numero minimo de muestras por hoja o poda posterior.\n\nEl aprendizaje no supervisado busca estructura en datos sin etiquetas explicitas. No intenta predecir una respuesta conocida, sino descubrir agrupamientos, dimensiones latentes o patrones frecuentes. Esto es util cuando se quiere explorar una poblacion de estudiantes o materiales sin imponer categorias previas.\n\nEl agrupamiento, o clustering, asigna observaciones a grupos segun similitud. Un ejemplo clasico es `k-means`, que busca `k` centroides y asigna cada punto al centro mas cercano.\n\n$$\nJ = \\sum_{i=1}^{n} \\min_{c \\in \\{1,\\dots,k\\}} ||x_i - \\mu_c||^2\n$$\n\nLa formula expresa que se minimiza la distancia de cada punto al centroide de su grupo. En educacion, el agrupamiento puede revelar perfiles de interaccion, como estudiantes que consultan teoria antes de practicar, estudiantes que saltan directo a ejercicios o estudiantes que repiten intentos sin revisar retroalimentacion.", content_text: "La salida se interpreta como `P(y = 1 | x)`. En un contexto educativo, podria estimar la probabilidad de que un estudiante necesite apoyo adicional en un tema. Esa probabilidad no debe confundirse con una etiqueta definitiva. La decision final depende de un umbral, del costo de falsos positivos y falsos negativos, y de la intervencion disponible.\n\nUn arbol de decision divide el espacio de atributos mediante reglas simples. Cada nodo interno plantea una condicion y cada hoja produce una prediccion. Su atractivo pedagogico es que permite visualizar una secuencia de decisiones.\n\nEjemplo simplificado:\n\n```text si dominio_de_prerrequisitos < 0.50: recomendar repaso guiado si no, si practica_reciente < 3 sesiones: recomendar ejercicios graduados si no: recomendar desafio aplicado ```\n\nAunque los arboles son interpretables, pueden sobreajustarse si crecen sin restricciones. Por eso suelen limitarse con profundidad maxima, numero minimo de muestras por hoja o poda posterior.\n\nEl aprendizaje no supervisado busca estructura en datos sin etiquetas explicitas. No intenta predecir una respuesta conocida, sino descubrir agrupamientos, dimensiones latentes o patrones frecuentes. Esto es util cuando se quiere explorar una poblacion de estudiantes o materiales sin imponer categorias previas.\n\nEl agrupamiento, o clustering, asigna observaciones a grupos segun similitud. Un ejemplo clasico es `k-means`, que busca `k` centroides y asigna cada punto al centro mas cercano.\n\n$$ J = \\sum_{i=1}^{n} \\min_{c \\in \\{1,\\dots,k\\}} ||x_i - \\mu_c||^2 $$\n\nLa formula expresa que se minimiza la distancia de cada punto al centroide de su grupo. En educacion, el agrupamiento puede revelar perfiles de interaccion, como estudiantes que consultan teoria antes de practicar, estudiantes que saltan directo a ejercicios o estudiantes que repiten intentos sin revisar retroalimentacion.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 144, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-6", node_type: "chunk", order: 6, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-2", source_chunk_ids: ["chunk-32", "chunk-33", "chunk-34", "chunk-35", "chunk-36", "chunk-37", "chunk-38", "chunk-39", "chunk-40"], source_hash: "cf61add3a07ce4771d988c21e12493b3e64ff2eb237b3c53b212dc57bef09a04", source_section_ids: ["section-11", "section-12", "section-13", "section-14"], source_section_titles: ["4.2 Regresion logistica", "4.3 Arboles de decision", "5. Aprendizaje no supervisado", "5.1 Agrupamiento"], start_position: 113, status: "active", title: "Salida interpreta p", token_count: 353, visibility: "private", word_count: 277};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-7"})
SET n:Chunk
SET n += {character_count: 2189, chunk_source_id: "graph-chunk-7", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"| Metodo | Idea principal | Uso educativo posible | Precaucion | | --- | --- | --- | --- | | k-means | centroides y distancia euclidiana | perfiles de actividad | requiere elegir `k` | | clustering jerarquico | fusion progresiva de grupos | explorar niveles de similitud | puede ser costoso | | DBSCAN | regiones densas | detectar patrones no esfericos | sensible a parametros | | modelos de mezcla | grupos probabilisticos | incertidumbre de pertenencia | supuestos distribucionales |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La reduccion de dimensionalidad transforma datos con muchos atributos en representaciones mas compactas. Esto puede ayudar a visualizar datos, eliminar ruido o preparar entradas para otros modelos. Tecnicas como PCA buscan direcciones de maxima varianza, mientras metodos no lineales capturan estructuras mas complejas.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"PCA se puede presentar como un cambio de coordenadas:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ Z = XW $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Donde `X` es la matriz de datos centrada, `W` contiene vectores principales y `Z` es la representacion proyectada. La interpretacion debe hacerse con cuidado: una proyeccion util para visualizar no siempre conserva todas las relaciones pedagogicamente relevantes.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El aprendizaje por refuerzo estudia agentes que interactuan con un entorno mediante acciones. El agente recibe recompensas y aprende una politica para maximizar recompensa acumulada. A diferencia del aprendizaje supervisado, no se le entrega la respuesta correcta para cada estado; debe explorar consecuencias.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Los elementos principales son:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Estado `s`: informacion disponible sobre la situacion actual. - Accion `a`: decision que toma el agente. - Recompensa `r`: senal de evaluacion inmediata. - Politica `\\\\pi(a|s)`: regla para elegir acciones. - Valor `V(s)`: estimacion de recompensa futura desde un estado.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La ecuacion de Bellman para una politica fija puede escribirse asi:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ V^\\\\pi(s) = \\\\mathbb{E}_\\\\pi \\\\left[ r_{t+1} + \\\\gamma V^\\\\pi(s_{t+1}) \\\\mid s_t = s \\\\right] $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En contextos educativos, el aprendizaje por refuerzo puede inspirar sistemas adaptativos que deciden que actividad recomendar despues. Sin embargo, su aplicacion requiere cautela porque explorar acciones suboptimas con estudiantes reales puede tener costos formativos.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "| Metodo | Idea principal | Uso educativo posible | Precaucion |\n| --- | --- | --- | --- |\n| k-means | centroides y distancia euclidiana | perfiles de actividad | requiere elegir `k` |\n| clustering jerarquico | fusion progresiva de grupos | explorar niveles de similitud | puede ser costoso |\n| DBSCAN | regiones densas | detectar patrones no esfericos | sensible a parametros |\n| modelos de mezcla | grupos probabilisticos | incertidumbre de pertenencia | supuestos distribucionales |\n\nLa reduccion de dimensionalidad transforma datos con muchos atributos en representaciones mas compactas. Esto puede ayudar a visualizar datos, eliminar ruido o preparar entradas para otros modelos. Tecnicas como PCA buscan direcciones de maxima varianza, mientras metodos no lineales capturan estructuras mas complejas.\n\nPCA se puede presentar como un cambio de coordenadas:\n\n$$\nZ = XW\n$$\n\nDonde `X` es la matriz de datos centrada, `W` contiene vectores principales y `Z` es la representacion proyectada. La interpretacion debe hacerse con cuidado: una proyeccion util para visualizar no siempre conserva todas las relaciones pedagogicamente relevantes.\n\nEl aprendizaje por refuerzo estudia agentes que interactuan con un entorno mediante acciones. El agente recibe recompensas y aprende una politica para maximizar recompensa acumulada. A diferencia del aprendizaje supervisado, no se le entrega la respuesta correcta para cada estado; debe explorar consecuencias.\n\nLos elementos principales son:\n\n- Estado `s`: informacion disponible sobre la situacion actual.\n- Accion `a`: decision que toma el agente.\n- Recompensa `r`: senal de evaluacion inmediata.\n- Politica `\\pi(a|s)`: regla para elegir acciones.\n- Valor `V(s)`: estimacion de recompensa futura desde un estado.\n\nLa ecuacion de Bellman para una politica fija puede escribirse asi:\n\n$$\nV^\\pi(s) = \\mathbb{E}_\\pi \\left[ r_{t+1} + \\gamma V^\\pi(s_{t+1}) \\mid s_t = s \\right]\n$$\n\nEn contextos educativos, el aprendizaje por refuerzo puede inspirar sistemas adaptativos que deciden que actividad recomendar despues. Sin embargo, su aplicacion requiere cautela porque explorar acciones suboptimas con estudiantes reales puede tener costos formativos.", content_text: "| Metodo | Idea principal | Uso educativo posible | Precaucion | | --- | --- | --- | --- | | k-means | centroides y distancia euclidiana | perfiles de actividad | requiere elegir `k` | | clustering jerarquico | fusion progresiva de grupos | explorar niveles de similitud | puede ser costoso | | DBSCAN | regiones densas | detectar patrones no esfericos | sensible a parametros | | modelos de mezcla | grupos probabilisticos | incertidumbre de pertenencia | supuestos distribucionales |\n\nLa reduccion de dimensionalidad transforma datos con muchos atributos en representaciones mas compactas. Esto puede ayudar a visualizar datos, eliminar ruido o preparar entradas para otros modelos. Tecnicas como PCA buscan direcciones de maxima varianza, mientras metodos no lineales capturan estructuras mas complejas.\n\nPCA se puede presentar como un cambio de coordenadas:\n\n$$ Z = XW $$\n\nDonde `X` es la matriz de datos centrada, `W` contiene vectores principales y `Z` es la representacion proyectada. La interpretacion debe hacerse con cuidado: una proyeccion util para visualizar no siempre conserva todas las relaciones pedagogicamente relevantes.\n\nEl aprendizaje por refuerzo estudia agentes que interactuan con un entorno mediante acciones. El agente recibe recompensas y aprende una politica para maximizar recompensa acumulada. A diferencia del aprendizaje supervisado, no se le entrega la respuesta correcta para cada estado; debe explorar consecuencias.\n\nLos elementos principales son:\n\n- Estado `s`: informacion disponible sobre la situacion actual. - Accion `a`: decision que toma el agente. - Recompensa `r`: senal de evaluacion inmediata. - Politica `\\pi(a|s)`: regla para elegir acciones. - Valor `V(s)`: estimacion de recompensa futura desde un estado.\n\nLa ecuacion de Bellman para una politica fija puede escribirse asi:\n\n$$ V^\\pi(s) = \\mathbb{E}_\\pi \\left[ r_{t+1} + \\gamma V^\\pi(s_{t+1}) \\mid s_t = s \\right] $$\n\nEn contextos educativos, el aprendizaje por refuerzo puede inspirar sistemas adaptativos que deciden que actividad recomendar despues. Sin embargo, su aplicacion requiere cautela porque explorar acciones suboptimas con estudiantes reales puede tener costos formativos.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 183, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-7", node_type: "chunk", order: 7, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-2", source_chunk_ids: ["chunk-41", "chunk-42", "chunk-43", "chunk-44", "chunk-45", "chunk-46", "chunk-47", "chunk-48", "chunk-49", "chunk-50", "chunk-51"], source_hash: "c34eb7c6981ccd7e05450fe18bc302b8f1ca5b9f31494516e4b07c51dee9b01d", source_section_ids: ["section-14", "section-15", "section-16"], source_section_titles: ["5.1 Agrupamiento", "5.2 Reduccion de dimensionalidad", "6. Aprendizaje por refuerzo"], start_position: 146, status: "active", title: "Pi s", token_count: 425, visibility: "private", word_count: 294};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-8"})
SET n:Chunk
SET n += {character_count: 1768, chunk_source_id: "graph-chunk-8", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Entrenar un modelo significa ajustar parametros para reducir una funcion de perdida. El procedimiento exacto depende del modelo, pero muchas tecnicas modernas usan variantes de descenso por gradiente. La idea general es modificar parametros en la direccion que reduce la perdida.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ \\\\theta_{t+1} = \\\\theta_t - \\\\eta \\\\nabla_\\\\theta L(\\\\theta_t) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Donde `\\\\eta` es la tasa de aprendizaje y `\\\\nabla_\\\\theta L` es el gradiente de la perdida respecto a los parametros. Si `\\\\eta` es demasiado grande, el entrenamiento puede oscilar; si es demasiado pequena, puede avanzar muy lento.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La funcion de perdida define que significa equivocarse. Por eso no es un detalle tecnico menor. En clasificacion binaria, una perdida comun es la entropia cruzada:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ L(y, \\\\hat{p}) = -y \\\\log(\\\\hat{p}) - (1-y)\\\\log(1-\\\\hat{p}) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Esta perdida penaliza fuertemente predicciones confiadas pero incorrectas. En tareas educativas, elegir la perdida adecuada puede depender del objetivo: no es lo mismo detectar riesgo academico, estimar dominio conceptual o recomendar materiales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La regularizacion agrega restricciones o penalizaciones para mejorar la generalizacion. En modelos lineales, dos penalizaciones frecuentes son L1 y L2.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Regularizacion | Penalizacion | Efecto usual | Interpretacion | | --- | --- | --- | --- | | L1 | `\\\\lambda \\\\sum_j |w_j|` | induce pesos cero | seleccion de variables | | L2 | `\\\\lambda \\\\sum_j w_j^2` | reduce magnitudes | estabilidad numerica | | Dropout | apaga unidades aleatorias | reduce coadaptacion | robustez en redes | | Early stopping | detiene entrenamiento | evita deterioro en validacion | control empirico |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La regularizacion no corrige datos mal definidos ni objetivos confusos. Solo controla la complejidad del modelo dentro de una formulacion dada.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Entrenar un modelo significa ajustar parametros para reducir una funcion de perdida. El procedimiento exacto depende del modelo, pero muchas tecnicas modernas usan variantes de descenso por gradiente. La idea general es modificar parametros en la direccion que reduce la perdida.\n\n$$\n\\theta_{t+1} = \\theta_t - \\eta \\nabla_\\theta L(\\theta_t)\n$$\n\nDonde `\\eta` es la tasa de aprendizaje y `\\nabla_\\theta L` es el gradiente de la perdida respecto a los parametros. Si `\\eta` es demasiado grande, el entrenamiento puede oscilar; si es demasiado pequena, puede avanzar muy lento.\n\nLa funcion de perdida define que significa equivocarse. Por eso no es un detalle tecnico menor. En clasificacion binaria, una perdida comun es la entropia cruzada:\n\n$$\nL(y, \\hat{p}) = -y \\log(\\hat{p}) - (1-y)\\log(1-\\hat{p})\n$$\n\nEsta perdida penaliza fuertemente predicciones confiadas pero incorrectas. En tareas educativas, elegir la perdida adecuada puede depender del objetivo: no es lo mismo detectar riesgo academico, estimar dominio conceptual o recomendar materiales.\n\nLa regularizacion agrega restricciones o penalizaciones para mejorar la generalizacion. En modelos lineales, dos penalizaciones frecuentes son L1 y L2.\n\n| Regularizacion | Penalizacion | Efecto usual | Interpretacion |\n| --- | --- | --- | --- |\n| L1 | `\\lambda \\sum_j |w_j|` | induce pesos cero | seleccion de variables |\n| L2 | `\\lambda \\sum_j w_j^2` | reduce magnitudes | estabilidad numerica |\n| Dropout | apaga unidades aleatorias | reduce coadaptacion | robustez en redes |\n| Early stopping | detiene entrenamiento | evita deterioro en validacion | control empirico |\n\nLa regularizacion no corrige datos mal definidos ni objetivos confusos. Solo controla la complejidad del modelo dentro de una formulacion dada.", content_text: "Entrenar un modelo significa ajustar parametros para reducir una funcion de perdida. El procedimiento exacto depende del modelo, pero muchas tecnicas modernas usan variantes de descenso por gradiente. La idea general es modificar parametros en la direccion que reduce la perdida.\n\n$$ \\theta_{t+1} = \\theta_t - \\eta \\nabla_\\theta L(\\theta_t) $$\n\nDonde `\\eta` es la tasa de aprendizaje y `\\nabla_\\theta L` es el gradiente de la perdida respecto a los parametros. Si `\\eta` es demasiado grande, el entrenamiento puede oscilar; si es demasiado pequena, puede avanzar muy lento.\n\nLa funcion de perdida define que significa equivocarse. Por eso no es un detalle tecnico menor. En clasificacion binaria, una perdida comun es la entropia cruzada:\n\n$$ L(y, \\hat{p}) = -y \\log(\\hat{p}) - (1-y)\\log(1-\\hat{p}) $$\n\nEsta perdida penaliza fuertemente predicciones confiadas pero incorrectas. En tareas educativas, elegir la perdida adecuada puede depender del objetivo: no es lo mismo detectar riesgo academico, estimar dominio conceptual o recomendar materiales.\n\nLa regularizacion agrega restricciones o penalizaciones para mejorar la generalizacion. En modelos lineales, dos penalizaciones frecuentes son L1 y L2.\n\n| Regularizacion | Penalizacion | Efecto usual | Interpretacion | | --- | --- | --- | --- | | L1 | `\\lambda \\sum_j |w_j|` | induce pesos cero | seleccion de variables | | L2 | `\\lambda \\sum_j w_j^2` | reduce magnitudes | estabilidad numerica | | Dropout | apaga unidades aleatorias | reduce coadaptacion | robustez en redes | | Early stopping | detiene entrenamiento | evita deterioro en validacion | control empirico |\n\nLa regularizacion no corrige datos mal definidos ni objetivos confusos. Solo controla la complejidad del modelo dentro de una formulacion dada.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 216, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-8", node_type: "chunk", order: 8, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-3", source_chunk_ids: ["chunk-52", "chunk-53", "chunk-54", "chunk-55", "chunk-56", "chunk-57", "chunk-58", "chunk-59", "chunk-60"], source_hash: "46c847e559f114e106a83d958fd94fa2e89fb4be40522e19f04a38e054c12926", source_section_ids: ["section-17", "section-18", "section-19"], source_section_titles: ["7. Entrenamiento, perdida y optimizacion", "7.1 Funcion de perdida", "7.2 Regularizacion"], start_position: 187, status: "active", title: "Theta t", token_count: 352, visibility: "private", word_count: 249};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-9"})
SET n:Chunk
SET n += {character_count: 1806, chunk_source_id: "graph-chunk-9", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"La generalizacion es la capacidad de un modelo para funcionar en datos no vistos. Un modelo sobreajustado aprende detalles accidentales del conjunto de entrenamiento y falla al enfrentar nuevos casos. Un modelo subajustado, en cambio, es demasiado simple para capturar la estructura relevante.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La tension entre sesgo y varianza suele presentarse como un equilibrio. Modelos simples tienen alto sesgo si no representan patrones importantes. Modelos muy flexibles pueden tener alta varianza si se adaptan demasiado a ruido.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Una practica fundamental es separar los datos en entrenamiento, validacion y prueba. Cada particion tiene un papel distinto:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Entrenamiento: ajustar parametros. - Validacion: elegir hiperparametros y comparar variantes. - Prueba: estimar desempeno final en datos no usados durante decisiones.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Si se usa el conjunto de prueba para tomar decisiones, deja de ser una prueba independiente. Este problema se llama fuga de informacion evaluativa.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La validacion cruzada divide los datos en varios pliegues. El modelo se entrena varias veces, usando un pliegue como validacion y los demas como entrenamiento. Esto produce una estimacion mas estable cuando los datos son limitados.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Variante | Descripcion | Ventaja | Desventaja | | --- | --- | --- | --- | | k-fold | divide en `k` partes | buen equilibrio | entrena `k` modelos | | estratificada | conserva proporciones de clase | util en clases desbalanceadas | requiere etiquetas | | leave-one-out | un caso por validacion | maximo uso de datos | costo alto | | temporal | respeta orden cronologico | evita mirar el futuro | menos aleatoria |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En datos educativos con dimension temporal, la particion debe respetar el orden de eventos. Entrenar con informacion posterior para predecir eventos anteriores produce resultados irreales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "La generalizacion es la capacidad de un modelo para funcionar en datos no vistos. Un modelo sobreajustado aprende detalles accidentales del conjunto de entrenamiento y falla al enfrentar nuevos casos. Un modelo subajustado, en cambio, es demasiado simple para capturar la estructura relevante.\n\nLa tension entre sesgo y varianza suele presentarse como un equilibrio. Modelos simples tienen alto sesgo si no representan patrones importantes. Modelos muy flexibles pueden tener alta varianza si se adaptan demasiado a ruido.\n\nUna practica fundamental es separar los datos en entrenamiento, validacion y prueba. Cada particion tiene un papel distinto:\n\n- Entrenamiento: ajustar parametros.\n- Validacion: elegir hiperparametros y comparar variantes.\n- Prueba: estimar desempeno final en datos no usados durante decisiones.\n\nSi se usa el conjunto de prueba para tomar decisiones, deja de ser una prueba independiente. Este problema se llama fuga de informacion evaluativa.\n\nLa validacion cruzada divide los datos en varios pliegues. El modelo se entrena varias veces, usando un pliegue como validacion y los demas como entrenamiento. Esto produce una estimacion mas estable cuando los datos son limitados.\n\n| Variante | Descripcion | Ventaja | Desventaja |\n| --- | --- | --- | --- |\n| k-fold | divide en `k` partes | buen equilibrio | entrena `k` modelos |\n| estratificada | conserva proporciones de clase | util en clases desbalanceadas | requiere etiquetas |\n| leave-one-out | un caso por validacion | maximo uso de datos | costo alto |\n| temporal | respeta orden cronologico | evita mirar el futuro | menos aleatoria |\n\nEn datos educativos con dimension temporal, la particion debe respetar el orden de eventos. Entrenar con informacion posterior para predecir eventos anteriores produce resultados irreales.", content_text: "La generalizacion es la capacidad de un modelo para funcionar en datos no vistos. Un modelo sobreajustado aprende detalles accidentales del conjunto de entrenamiento y falla al enfrentar nuevos casos. Un modelo subajustado, en cambio, es demasiado simple para capturar la estructura relevante.\n\nLa tension entre sesgo y varianza suele presentarse como un equilibrio. Modelos simples tienen alto sesgo si no representan patrones importantes. Modelos muy flexibles pueden tener alta varianza si se adaptan demasiado a ruido.\n\nUna practica fundamental es separar los datos en entrenamiento, validacion y prueba. Cada particion tiene un papel distinto:\n\n- Entrenamiento: ajustar parametros. - Validacion: elegir hiperparametros y comparar variantes. - Prueba: estimar desempeno final en datos no usados durante decisiones.\n\nSi se usa el conjunto de prueba para tomar decisiones, deja de ser una prueba independiente. Este problema se llama fuga de informacion evaluativa.\n\nLa validacion cruzada divide los datos en varios pliegues. El modelo se entrena varias veces, usando un pliegue como validacion y los demas como entrenamiento. Esto produce una estimacion mas estable cuando los datos son limitados.\n\n| Variante | Descripcion | Ventaja | Desventaja | | --- | --- | --- | --- | | k-fold | divide en `k` partes | buen equilibrio | entrena `k` modelos | | estratificada | conserva proporciones de clase | util en clases desbalanceadas | requiere etiquetas | | leave-one-out | un caso por validacion | maximo uso de datos | costo alto | | temporal | respeta orden cronologico | evita mirar el futuro | menos aleatoria |\n\nEn datos educativos con dimension temporal, la particion debe respetar el orden de eventos. Entrenar con informacion posterior para predecir eventos anteriores produce resultados irreales.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 245, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-9", node_type: "chunk", order: 9, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-3", source_chunk_ids: ["chunk-61", "chunk-62", "chunk-63", "chunk-64", "chunk-65", "chunk-66", "chunk-67", "chunk-68"], source_hash: "03230b83c31a281f1f39b4f4be3ad58a3855d6f2e289bb9493c5e5e6b20cdfbc", source_section_ids: ["section-20", "section-21", "section-22"], source_section_titles: ["8. Generalizacion y sobreajuste", "8.1 Separacion de datos", "8.2 Validacion cruzada"], start_position: 220, status: "active", title: "Datos no", token_count: 366, visibility: "private", word_count: 246};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-10"})
SET n:Chunk
SET n += {character_count: 1572, chunk_source_id: "graph-chunk-10", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Las metricas traducen desempeno en numeros. Elegir una metrica implica decidir que errores importan mas. En clasificacion binaria, exactitud puede ser enganosa si las clases estan desbalanceadas. Por eso se usan precision, recall, F1, AUC y matrices de confusion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La matriz de confusion resume aciertos y errores segun clase real y clase predicha.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Real / Predicho | Positivo | Negativo | | --- | ---: | ---: | | Positivo | Verdadero positivo | Falso negativo | | Negativo | Falso positivo | Verdadero negativo |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"A partir de esta tabla se derivan varias metricas:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ Precision = \\\\frac{TP}{TP + FP} $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ Recall = \\\\frac{TP}{TP + FN} $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ F1 = 2 \\\\cdot \\\\frac{Precision \\\\cdot Recall}{Precision + Recall} $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"En un sistema de apoyo educativo, un falso negativo puede significar no detectar a un estudiante que necesita ayuda. Un falso positivo puede asignar apoyo innecesario. La importancia relativa depende de la intervencion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Para regresion se usan metricas como MAE, MSE y RMSE. MAE mide error absoluto promedio, mientras RMSE penaliza mas los errores grandes.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Metrica | Formula | Sensibilidad | Uso comun | | --- | --- | --- | --- | | MAE | `mean(|y - y_hat|)` | lineal | interpretacion directa | | MSE | `mean((y - y_hat)^2)` | alta a outliers | optimizacion matematica | | RMSE | `sqrt(MSE)` | alta a outliers | misma unidad que `y` | | R2 | proporcion de varianza explicada | depende del baseline | resumen global |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La evaluacion debe acompanarse con analisis de errores. Un promedio puede ocultar que el modelo funciona bien para un grupo y mal para otro.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Las metricas traducen desempeno en numeros. Elegir una metrica implica decidir que errores importan mas. En clasificacion binaria, exactitud puede ser enganosa si las clases estan desbalanceadas. Por eso se usan precision, recall, F1, AUC y matrices de confusion.\n\nLa matriz de confusion resume aciertos y errores segun clase real y clase predicha.\n\n| Real / Predicho | Positivo | Negativo |\n| --- | ---: | ---: |\n| Positivo | Verdadero positivo | Falso negativo |\n| Negativo | Falso positivo | Verdadero negativo |\n\nA partir de esta tabla se derivan varias metricas:\n\n$$\nPrecision = \\frac{TP}{TP + FP}\n$$\n\n$$\nRecall = \\frac{TP}{TP + FN}\n$$\n\n$$\nF1 = 2 \\cdot \\frac{Precision \\cdot Recall}{Precision + Recall}\n$$\n\nEn un sistema de apoyo educativo, un falso negativo puede significar no detectar a un estudiante que necesita ayuda. Un falso positivo puede asignar apoyo innecesario. La importancia relativa depende de la intervencion.\n\nPara regresion se usan metricas como MAE, MSE y RMSE. MAE mide error absoluto promedio, mientras RMSE penaliza mas los errores grandes.\n\n| Metrica | Formula | Sensibilidad | Uso comun |\n| --- | --- | --- | --- |\n| MAE | `mean(|y - y_hat|)` | lineal | interpretacion directa |\n| MSE | `mean((y - y_hat)^2)` | alta a outliers | optimizacion matematica |\n| RMSE | `sqrt(MSE)` | alta a outliers | misma unidad que `y` |\n| R2 | proporcion de varianza explicada | depende del baseline | resumen global |\n\nLa evaluacion debe acompanarse con analisis de errores. Un promedio puede ocultar que el modelo funciona bien para un grupo y mal para otro.", content_text: "Las metricas traducen desempeno en numeros. Elegir una metrica implica decidir que errores importan mas. En clasificacion binaria, exactitud puede ser enganosa si las clases estan desbalanceadas. Por eso se usan precision, recall, F1, AUC y matrices de confusion.\n\nLa matriz de confusion resume aciertos y errores segun clase real y clase predicha.\n\n| Real / Predicho | Positivo | Negativo | | --- | ---: | ---: | | Positivo | Verdadero positivo | Falso negativo | | Negativo | Falso positivo | Verdadero negativo |\n\nA partir de esta tabla se derivan varias metricas:\n\n$$ Precision = \\frac{TP}{TP + FP} $$\n\n$$ Recall = \\frac{TP}{TP + FN} $$\n\n$$ F1 = 2 \\cdot \\frac{Precision \\cdot Recall}{Precision + Recall} $$\n\nEn un sistema de apoyo educativo, un falso negativo puede significar no detectar a un estudiante que necesita ayuda. Un falso positivo puede asignar apoyo innecesario. La importancia relativa depende de la intervencion.\n\nPara regresion se usan metricas como MAE, MSE y RMSE. MAE mide error absoluto promedio, mientras RMSE penaliza mas los errores grandes.\n\n| Metrica | Formula | Sensibilidad | Uso comun | | --- | --- | --- | --- | | MAE | `mean(|y - y_hat|)` | lineal | interpretacion directa | | MSE | `mean((y - y_hat)^2)` | alta a outliers | optimizacion matematica | | RMSE | `sqrt(MSE)` | alta a outliers | misma unidad que `y` | | R2 | proporcion de varianza explicada | depende del baseline | resumen global |\n\nLa evaluacion debe acompanarse con analisis de errores. Un promedio puede ocultar que el modelo funciona bien para un grupo y mal para otro.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 287, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-10", node_type: "chunk", order: 10, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-3", source_chunk_ids: ["chunk-69", "chunk-70", "chunk-71", "chunk-72", "chunk-73", "chunk-74", "chunk-75", "chunk-76", "chunk-77", "chunk-78", "chunk-79"], source_hash: "7eadf0ad995e54131203ec57b05d6df192ca856b0bcfee88f3a5ae8238a2f605", source_section_ids: ["section-23", "section-24", "section-25"], source_section_titles: ["9. Metricas de evaluacion", "9.1 Matriz de confusion", "9.2 Evaluacion en regresion"], start_position: 249, status: "active", title: "Frac tp tp", token_count: 356, visibility: "private", word_count: 218};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-11"})
SET n:Chunk
SET n += {character_count: 1956, chunk_source_id: "graph-chunk-11", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"La interpretabilidad se refiere a la facilidad con que una persona entiende el funcionamiento de un modelo. La explicabilidad busca producir razones o aproximaciones que aclaren una prediccion. En educacion, estas propiedades son importantes porque las decisiones pueden afectar trayectorias de aprendizaje.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Un modelo lineal con pocos atributos puede ser interpretable directamente. Una red neuronal profunda suele requerir metodos adicionales para explicar predicciones. Sin embargo, una explicacion aproximada no garantiza justicia ni validez pedagogica.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Las explicaciones locales describen por que el modelo hizo una prediccion especifica. Pueden responder preguntas como: \\\"Que variables hicieron que el sistema recomendara repasar fracciones?\\\".\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"```text Prediccion: necesita repaso de fracciones Factores principales: - bajo desempeno en equivalencias - errores recientes en simplificacion - tiempo largo en ejercicios basicos Accion sugerida: - actividad guiada con retroalimentacion inmediata ```\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Este bloque debe conservar su formato, ya que la indentacion comunica una estructura de explicacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Las explicaciones globales describen patrones generales del modelo. Por ejemplo, pueden indicar que el dominio de prerrequisitos pesa mas que el tiempo total en plataforma. Estas explicaciones ayudan a revisar si el modelo coincide con conocimiento experto.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Puntos clave para evaluar explicaciones:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Una explicacion debe ser comprensible para su audiencia. - Debe evitar presentar correlaciones como causalidad. - Debe indicar incertidumbre cuando sea relevante. - Debe poder contrastarse con casos reales. - Debe documentar limitaciones del metodo usado.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Un modelo puede reproducir sesgos presentes en datos historicos. Si ciertos estudiantes tuvieron menos acceso a recursos, sus registros pueden reflejar desigualdad estructural y no capacidad individual. Un sistema que aprende de esos datos sin analisis puede reforzar decisiones injustas.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "La interpretabilidad se refiere a la facilidad con que una persona entiende el funcionamiento de un modelo. La explicabilidad busca producir razones o aproximaciones que aclaren una prediccion. En educacion, estas propiedades son importantes porque las decisiones pueden afectar trayectorias de aprendizaje.\n\nUn modelo lineal con pocos atributos puede ser interpretable directamente. Una red neuronal profunda suele requerir metodos adicionales para explicar predicciones. Sin embargo, una explicacion aproximada no garantiza justicia ni validez pedagogica.\n\nLas explicaciones locales describen por que el modelo hizo una prediccion especifica. Pueden responder preguntas como: \"Que variables hicieron que el sistema recomendara repasar fracciones?\".\n\n```text\nPrediccion: necesita repaso de fracciones\nFactores principales:\n- bajo desempeno en equivalencias\n- errores recientes en simplificacion\n- tiempo largo en ejercicios basicos\nAccion sugerida:\n- actividad guiada con retroalimentacion inmediata\n```\n\nEste bloque debe conservar su formato, ya que la indentacion comunica una estructura de explicacion.\n\nLas explicaciones globales describen patrones generales del modelo. Por ejemplo, pueden indicar que el dominio de prerrequisitos pesa mas que el tiempo total en plataforma. Estas explicaciones ayudan a revisar si el modelo coincide con conocimiento experto.\n\nPuntos clave para evaluar explicaciones:\n\n- Una explicacion debe ser comprensible para su audiencia.\n- Debe evitar presentar correlaciones como causalidad.\n- Debe indicar incertidumbre cuando sea relevante.\n- Debe poder contrastarse con casos reales.\n- Debe documentar limitaciones del metodo usado.\n\nUn modelo puede reproducir sesgos presentes en datos historicos. Si ciertos estudiantes tuvieron menos acceso a recursos, sus registros pueden reflejar desigualdad estructural y no capacidad individual. Un sistema que aprende de esos datos sin analisis puede reforzar decisiones injustas.", content_text: "La interpretabilidad se refiere a la facilidad con que una persona entiende el funcionamiento de un modelo. La explicabilidad busca producir razones o aproximaciones que aclaren una prediccion. En educacion, estas propiedades son importantes porque las decisiones pueden afectar trayectorias de aprendizaje.\n\nUn modelo lineal con pocos atributos puede ser interpretable directamente. Una red neuronal profunda suele requerir metodos adicionales para explicar predicciones. Sin embargo, una explicacion aproximada no garantiza justicia ni validez pedagogica.\n\nLas explicaciones locales describen por que el modelo hizo una prediccion especifica. Pueden responder preguntas como: \"Que variables hicieron que el sistema recomendara repasar fracciones?\".\n\n```text Prediccion: necesita repaso de fracciones Factores principales: - bajo desempeno en equivalencias - errores recientes en simplificacion - tiempo largo en ejercicios basicos Accion sugerida: - actividad guiada con retroalimentacion inmediata ```\n\nEste bloque debe conservar su formato, ya que la indentacion comunica una estructura de explicacion.\n\nLas explicaciones globales describen patrones generales del modelo. Por ejemplo, pueden indicar que el dominio de prerrequisitos pesa mas que el tiempo total en plataforma. Estas explicaciones ayudan a revisar si el modelo coincide con conocimiento experto.\n\nPuntos clave para evaluar explicaciones:\n\n- Una explicacion debe ser comprensible para su audiencia. - Debe evitar presentar correlaciones como causalidad. - Debe indicar incertidumbre cuando sea relevante. - Debe poder contrastarse con casos reales. - Debe documentar limitaciones del metodo usado.\n\nUn modelo puede reproducir sesgos presentes en datos historicos. Si ciertos estudiantes tuvieron menos acceso a recursos, sus registros pueden reflejar desigualdad estructural y no capacidad individual. Un sistema que aprende de esos datos sin analisis puede reforzar decisiones injustas.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 325, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-11", node_type: "chunk", order: 11, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-4", source_chunk_ids: ["chunk-80", "chunk-81", "chunk-82", "chunk-83", "chunk-84", "chunk-85", "chunk-86", "chunk-87", "chunk-88"], source_hash: "3cd3b14cebdfc47a647a026b2b67b27cad40e3b5f4e3b823fad25416f7312258", source_section_ids: ["section-26", "section-27", "section-28", "section-29"], source_section_titles: ["10. Interpretabilidad y explicabilidad", "10.1 Explicaciones locales", "10.2 Explicaciones globales", "11. Sesgo, equidad y responsabilidad"], start_position: 291, status: "active", title: "Interpretabilidad refiere facilidad", token_count: 345, visibility: "private", word_count: 256};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-12"})
SET n:Chunk
SET n += {character_count: 2418, chunk_source_id: "graph-chunk-12", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"La equidad en Machine Learning no se resuelve con una sola metrica. Requiere comprender contexto, grupos afectados, intervenciones disponibles y consecuencias. A veces mejorar una metrica global empeora resultados para un subgrupo.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Fuente | Descripcion | Ejemplo educativo | Posible mitigacion | | --- | --- | --- | --- | | Muestreo | poblacion no representativa | datos solo de escuelas urbanas | ampliar cobertura | | Medicion | variable imperfecta | tiempo en pantalla como atencion | validar indicadores | | Etiquetado | etiquetas inconsistentes | rubricas aplicadas distinto | calibrar evaluadores | | Historico | desigualdad previa | acceso desigual a tutoria | auditar resultados | | Implementacion | uso fuera de contexto | modelo usado para castigar | gobernanza clara |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El analisis de sesgo debe formar parte del ciclo de vida del modelo. No debe agregarse al final como requisito cosmetico.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"> Un sistema predictivo en educacion debe apoyar decisiones humanas, no reemplazar el juicio pedagogico ni reducir a los estudiantes a una puntuacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Principios recomendados:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Finalidad clara y comunicada. - Consentimiento y proteccion de datos. - Evaluacion por subgrupos relevantes. - Supervision humana en decisiones sensibles. - Mecanismos de apelacion o correccion. - Monitoreo continuo despues del despliegue.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Un proyecto de Machine Learning no empieza con elegir un algoritmo. Empieza con una pregunta y con la definicion de un resultado util. Despues se exploran datos, se preparan variables, se entrena un baseline, se evalua, se interpreta y se decide si el modelo aporta valor.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"```python def flujo_ml(datos): problema = definir_pregunta(datos) particiones = separar_datos(datos) caracteristicas = preparar_variables(particiones.entrenamiento) modelo = entrenar_baseline(caracteristicas) resultados = evaluar(modelo, particiones.validacion) reporte = documentar(resultados) return reporte ```\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El codigo anterior no pretende ejecutarse como implementacion final. Su funcion pedagogica es mostrar las etapas de un ciclo reproducible.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- La pregunta predictiva esta escrita en lenguaje claro. - La variable objetivo esta definida antes de entrenar. - La particion de datos evita fuga temporal o institucional. - Hay un baseline simple para comparar. - Las metricas responden al uso educativo esperado. - Los errores se revisan cualitativamente. - El modelo se documenta con alcance y limitaciones.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "La equidad en Machine Learning no se resuelve con una sola metrica. Requiere comprender contexto, grupos afectados, intervenciones disponibles y consecuencias. A veces mejorar una metrica global empeora resultados para un subgrupo.\n\n| Fuente | Descripcion | Ejemplo educativo | Posible mitigacion |\n| --- | --- | --- | --- |\n| Muestreo | poblacion no representativa | datos solo de escuelas urbanas | ampliar cobertura |\n| Medicion | variable imperfecta | tiempo en pantalla como atencion | validar indicadores |\n| Etiquetado | etiquetas inconsistentes | rubricas aplicadas distinto | calibrar evaluadores |\n| Historico | desigualdad previa | acceso desigual a tutoria | auditar resultados |\n| Implementacion | uso fuera de contexto | modelo usado para castigar | gobernanza clara |\n\nEl analisis de sesgo debe formar parte del ciclo de vida del modelo. No debe agregarse al final como requisito cosmetico.\n\n> Un sistema predictivo en educacion debe apoyar decisiones humanas, no reemplazar el juicio pedagogico ni reducir a los estudiantes a una puntuacion.\n\nPrincipios recomendados:\n\n- Finalidad clara y comunicada.\n- Consentimiento y proteccion de datos.\n- Evaluacion por subgrupos relevantes.\n- Supervision humana en decisiones sensibles.\n- Mecanismos de apelacion o correccion.\n- Monitoreo continuo despues del despliegue.\n\nUn proyecto de Machine Learning no empieza con elegir un algoritmo. Empieza con una pregunta y con la definicion de un resultado util. Despues se exploran datos, se preparan variables, se entrena un baseline, se evalua, se interpreta y se decide si el modelo aporta valor.\n\n```python\ndef flujo_ml(datos):\nproblema = definir_pregunta(datos)\nparticiones = separar_datos(datos)\ncaracteristicas = preparar_variables(particiones.entrenamiento)\nmodelo = entrenar_baseline(caracteristicas)\nresultados = evaluar(modelo, particiones.validacion)\nreporte = documentar(resultados)\nreturn reporte\n```\n\nEl codigo anterior no pretende ejecutarse como implementacion final. Su funcion pedagogica es mostrar las etapas de un ciclo reproducible.\n\n- La pregunta predictiva esta escrita en lenguaje claro.\n- La variable objetivo esta definida antes de entrenar.\n- La particion de datos evita fuga temporal o institucional.\n- Hay un baseline simple para comparar.\n- Las metricas responden al uso educativo esperado.\n- Los errores se revisan cualitativamente.\n- El modelo se documenta con alcance y limitaciones.", content_text: "La equidad en Machine Learning no se resuelve con una sola metrica. Requiere comprender contexto, grupos afectados, intervenciones disponibles y consecuencias. A veces mejorar una metrica global empeora resultados para un subgrupo.\n\n| Fuente | Descripcion | Ejemplo educativo | Posible mitigacion | | --- | --- | --- | --- | | Muestreo | poblacion no representativa | datos solo de escuelas urbanas | ampliar cobertura | | Medicion | variable imperfecta | tiempo en pantalla como atencion | validar indicadores | | Etiquetado | etiquetas inconsistentes | rubricas aplicadas distinto | calibrar evaluadores | | Historico | desigualdad previa | acceso desigual a tutoria | auditar resultados | | Implementacion | uso fuera de contexto | modelo usado para castigar | gobernanza clara |\n\nEl analisis de sesgo debe formar parte del ciclo de vida del modelo. No debe agregarse al final como requisito cosmetico.\n\n> Un sistema predictivo en educacion debe apoyar decisiones humanas, no reemplazar el juicio pedagogico ni reducir a los estudiantes a una puntuacion.\n\nPrincipios recomendados:\n\n- Finalidad clara y comunicada. - Consentimiento y proteccion de datos. - Evaluacion por subgrupos relevantes. - Supervision humana en decisiones sensibles. - Mecanismos de apelacion o correccion. - Monitoreo continuo despues del despliegue.\n\nUn proyecto de Machine Learning no empieza con elegir un algoritmo. Empieza con una pregunta y con la definicion de un resultado util. Despues se exploran datos, se preparan variables, se entrena un baseline, se evalua, se interpreta y se decide si el modelo aporta valor.\n\n```python def flujo_ml(datos): problema = definir_pregunta(datos) particiones = separar_datos(datos) caracteristicas = preparar_variables(particiones.entrenamiento) modelo = entrenar_baseline(caracteristicas) resultados = evaluar(modelo, particiones.validacion) reporte = documentar(resultados) return reporte ```\n\nEl codigo anterior no pretende ejecutarse como implementacion final. Su funcion pedagogica es mostrar las etapas de un ciclo reproducible.\n\n- La pregunta predictiva esta escrita en lenguaje claro. - La variable objetivo esta definida antes de entrenar. - La particion de datos evita fuga temporal o institucional. - Hay un baseline simple para comparar. - Las metricas responden al uso educativo esperado. - Los errores se revisan cualitativamente. - El modelo se documenta con alcance y limitaciones.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 381, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-12", node_type: "chunk", order: 12, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-4", source_chunk_ids: ["chunk-89", "chunk-90", "chunk-91", "chunk-92", "chunk-93", "chunk-94", "chunk-95", "chunk-96", "chunk-97", "chunk-98"], source_hash: "0e194ec517f39370f31bd575183af43e0ec9135365a497e789549ecf69fa4cc8", source_section_ids: ["section-29", "section-30", "section-31", "section-32", "section-33", "section-34"], source_section_titles: ["11. Sesgo, equidad y responsabilidad", "11.1 Fuentes de sesgo", "11.2 Principios de uso responsable", "12. Flujo de trabajo de un proyecto de ML", "12.1 Ciclo basico", "12.2 Checklist de proyecto"], start_position: 327, status: "active", title: "Machine learning no", token_count: 461, visibility: "private", word_count: 309};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-13"})
SET n:Chunk
SET n += {character_count: 1947, chunk_source_id: "graph-chunk-13", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Supongamos una plataforma que recomienda ejercicios de algebra. El objetivo no es maximizar clics, sino seleccionar actividades que ayuden al estudiante a consolidar prerrequisitos y avanzar con dificultad adecuada.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Las entradas podrian incluir desempeno por tema, historial de errores, tiempo desde la ultima practica, nivel de dificultad de ejercicios previos y secuencia curricular. La salida podria ser una recomendacion entre varias actividades disponibles.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Elemento | Decision del caso | | --- | --- | | Tarea | recomendar siguiente actividad | | Unidad de prediccion | estudiante-tema-sesion | | Objetivo | mejorar dominio conceptual | | Etiqueta posible | mejora posterior en evaluacion corta | | Restriccion | no repetir ejercicios ya dominados | | Riesgo | encerrar al estudiante en tareas faciles |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Este caso muestra por que la definicion de etiqueta es dificil. Si se usa solo mejora inmediata, el sistema podria recomendar actividades faciles que producen ganancias rapidas pero superficiales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Una funcion de utilidad educativa podria combinar aprendizaje esperado, diversidad y ajuste de dificultad.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ U(a, s) = \\\\lambda_1 \\\\cdot aprendizaje\\\\_esperado(a, s) + \\\\lambda_2 \\\\cdot diversidad(a) - \\\\lambda_3 \\\\cdot frustracion\\\\_estimada(a, s) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"La funcion anterior no es universal. Sirve para discutir que las recomendaciones no se optimizan solo por probabilidad de acierto.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Las redes neuronales son modelos compuestos por capas de transformaciones parametrizadas. Cada capa recibe una representacion y produce otra. La profundidad permite construir representaciones jerarquicas, aunque tambien aumenta complejidad de entrenamiento e interpretacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Una neurona artificial simple calcula una combinacion lineal seguida de una funcion de activacion:\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ h = \\\\phi(w^Tx + b) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Donde `\\\\phi` puede ser ReLU, sigmoide u otra funcion no lineal. Sin no linealidades, muchas capas lineales equivaldrian a una sola transformacion lineal.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Supongamos una plataforma que recomienda ejercicios de algebra. El objetivo no es maximizar clics, sino seleccionar actividades que ayuden al estudiante a consolidar prerrequisitos y avanzar con dificultad adecuada.\n\nLas entradas podrian incluir desempeno por tema, historial de errores, tiempo desde la ultima practica, nivel de dificultad de ejercicios previos y secuencia curricular. La salida podria ser una recomendacion entre varias actividades disponibles.\n\n| Elemento | Decision del caso |\n| --- | --- |\n| Tarea | recomendar siguiente actividad |\n| Unidad de prediccion | estudiante-tema-sesion |\n| Objetivo | mejorar dominio conceptual |\n| Etiqueta posible | mejora posterior en evaluacion corta |\n| Restriccion | no repetir ejercicios ya dominados |\n| Riesgo | encerrar al estudiante en tareas faciles |\n\nEste caso muestra por que la definicion de etiqueta es dificil. Si se usa solo mejora inmediata, el sistema podria recomendar actividades faciles que producen ganancias rapidas pero superficiales.\n\nUna funcion de utilidad educativa podria combinar aprendizaje esperado, diversidad y ajuste de dificultad.\n\n$$\nU(a, s) =\n\\lambda_1 \\cdot aprendizaje\\_esperado(a, s)\n+ \\lambda_2 \\cdot diversidad(a)\n- \\lambda_3 \\cdot frustracion\\_estimada(a, s)\n$$\n\nLa funcion anterior no es universal. Sirve para discutir que las recomendaciones no se optimizan solo por probabilidad de acierto.\n\nLas redes neuronales son modelos compuestos por capas de transformaciones parametrizadas. Cada capa recibe una representacion y produce otra. La profundidad permite construir representaciones jerarquicas, aunque tambien aumenta complejidad de entrenamiento e interpretacion.\n\nUna neurona artificial simple calcula una combinacion lineal seguida de una funcion de activacion:\n\n$$\nh = \\phi(w^Tx + b)\n$$\n\nDonde `\\phi` puede ser ReLU, sigmoide u otra funcion no lineal. Sin no linealidades, muchas capas lineales equivaldrian a una sola transformacion lineal.", content_text: "Supongamos una plataforma que recomienda ejercicios de algebra. El objetivo no es maximizar clics, sino seleccionar actividades que ayuden al estudiante a consolidar prerrequisitos y avanzar con dificultad adecuada.\n\nLas entradas podrian incluir desempeno por tema, historial de errores, tiempo desde la ultima practica, nivel de dificultad de ejercicios previos y secuencia curricular. La salida podria ser una recomendacion entre varias actividades disponibles.\n\n| Elemento | Decision del caso | | --- | --- | | Tarea | recomendar siguiente actividad | | Unidad de prediccion | estudiante-tema-sesion | | Objetivo | mejorar dominio conceptual | | Etiqueta posible | mejora posterior en evaluacion corta | | Restriccion | no repetir ejercicios ya dominados | | Riesgo | encerrar al estudiante en tareas faciles |\n\nEste caso muestra por que la definicion de etiqueta es dificil. Si se usa solo mejora inmediata, el sistema podria recomendar actividades faciles que producen ganancias rapidas pero superficiales.\n\nUna funcion de utilidad educativa podria combinar aprendizaje esperado, diversidad y ajuste de dificultad.\n\n$$ U(a, s) = \\lambda_1 \\cdot aprendizaje\\_esperado(a, s) + \\lambda_2 \\cdot diversidad(a) - \\lambda_3 \\cdot frustracion\\_estimada(a, s) $$\n\nLa funcion anterior no es universal. Sirve para discutir que las recomendaciones no se optimizan solo por probabilidad de acierto.\n\nLas redes neuronales son modelos compuestos por capas de transformaciones parametrizadas. Cada capa recibe una representacion y produce otra. La profundidad permite construir representaciones jerarquicas, aunque tambien aumenta complejidad de entrenamiento e interpretacion.\n\nUna neurona artificial simple calcula una combinacion lineal seguida de una funcion de activacion:\n\n$$ h = \\phi(w^Tx + b) $$\n\nDonde `\\phi` puede ser ReLU, sigmoide u otra funcion no lineal. Sin no linealidades, muchas capas lineales equivaldrian a una sola transformacion lineal.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 425, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-13", node_type: "chunk", order: 13, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-5", source_chunk_ids: ["chunk-99", "chunk-100", "chunk-101", "chunk-102", "chunk-103", "chunk-104", "chunk-105", "chunk-106", "chunk-107", "chunk-108", "chunk-109"], source_hash: "55d452ddbfdfe483612fecc492d9253de5b1225b57441e0748f7439685a6097a", source_section_ids: ["section-35", "section-36", "section-37", "section-38"], source_section_titles: ["13. Caso aplicado: recomendacion de practica personalizada", "13.1 Definicion del problema", "13.2 Funcion de utilidad", "14. Redes neuronales y representaciones"], start_position: 385, status: "active", title: "Aprendizaje esperado", token_count: 367, visibility: "private", word_count: 260};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-14"})
SET n:Chunk
SET n += {character_count: 1708, chunk_source_id: "graph-chunk-14", chunk_type: "merged_paragraphs", content_json: "{\"content\": [{\"content\": [{\"text\": \"Un embedding representa objetos discretos, como palabras, ejercicios o estudiantes, mediante vectores densos. En educacion, embeddings pueden capturar similitud entre conceptos o patrones de interaccion. Sin embargo, tambien pueden codificar sesgos si se entrenan sobre datos historicos no revisados.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"| Objeto | Representacion posible | Uso | | --- | --- | --- | | Palabra | vector semantico | analizar respuestas abiertas | | Ejercicio | vector de dificultad y tema | recomendar practica | | Concepto | vector curricular | conectar prerrequisitos | | Estudiante | vector de estado de aprendizaje | personalizar secuencia |\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Un embedding no es una explicacion por si mismo. Es una herramienta representacional que requiere interpretacion externa.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Los modelos generativos aprenden distribuciones que permiten producir texto, imagenes, audio u otros datos. En lenguaje, un modelo generativo estima la probabilidad de una secuencia de tokens y puede generar continuaciones plausibles.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"$$ P(x_1, x_2, \\\\dots, x_n) = \\\\prod_{t=1}^{n} P(x_t \\\\mid x_1, \\\\dots, x_{t-1}) $$\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"Esta descomposicion expresa que la probabilidad de una secuencia se construye token por token. En aplicaciones educativas, los modelos de lenguaje pueden apoyar explicaciones, retroalimentacion y generacion de ejercicios, pero requieren verificacion.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"- Pueden producir respuestas fluidas pero incorrectas. - Pueden inventar fuentes o justificar errores. - Pueden reflejar sesgos del corpus de entrenamiento. - Pueden no distinguir entre ayuda pedagogica y solucion directa. - Pueden requerir guardrails para proteger datos personales.\", \"type\": \"text\"}], \"type\": \"paragraph\"}, {\"content\": [{\"text\": \"El uso educativo responsable exige combinar generacion con evaluacion, trazabilidad y supervision humana.\", \"type\": \"text\"}], \"type\": \"paragraph\"}], \"type\": \"doc\"}", content_markdown: "Un embedding representa objetos discretos, como palabras, ejercicios o estudiantes, mediante vectores densos. En educacion, embeddings pueden capturar similitud entre conceptos o patrones de interaccion. Sin embargo, tambien pueden codificar sesgos si se entrenan sobre datos historicos no revisados.\n\n| Objeto | Representacion posible | Uso |\n| --- | --- | --- |\n| Palabra | vector semantico | analizar respuestas abiertas |\n| Ejercicio | vector de dificultad y tema | recomendar practica |\n| Concepto | vector curricular | conectar prerrequisitos |\n| Estudiante | vector de estado de aprendizaje | personalizar secuencia |\n\nUn embedding no es una explicacion por si mismo. Es una herramienta representacional que requiere interpretacion externa.\n\nLos modelos generativos aprenden distribuciones que permiten producir texto, imagenes, audio u otros datos. En lenguaje, un modelo generativo estima la probabilidad de una secuencia de tokens y puede generar continuaciones plausibles.\n\n$$\nP(x_1, x_2, \\dots, x_n) = \\prod_{t=1}^{n} P(x_t \\mid x_1, \\dots, x_{t-1})\n$$\n\nEsta descomposicion expresa que la probabilidad de una secuencia se construye token por token. En aplicaciones educativas, los modelos de lenguaje pueden apoyar explicaciones, retroalimentacion y generacion de ejercicios, pero requieren verificacion.\n\n- Pueden producir respuestas fluidas pero incorrectas.\n- Pueden inventar fuentes o justificar errores.\n- Pueden reflejar sesgos del corpus de entrenamiento.\n- Pueden no distinguir entre ayuda pedagogica y solucion directa.\n- Pueden requerir guardrails para proteger datos personales.\n\nEl uso educativo responsable exige combinar generacion con evaluacion, trazabilidad y supervision humana.", content_text: "Un embedding representa objetos discretos, como palabras, ejercicios o estudiantes, mediante vectores densos. En educacion, embeddings pueden capturar similitud entre conceptos o patrones de interaccion. Sin embargo, tambien pueden codificar sesgos si se entrenan sobre datos historicos no revisados.\n\n| Objeto | Representacion posible | Uso | | --- | --- | --- | | Palabra | vector semantico | analizar respuestas abiertas | | Ejercicio | vector de dificultad y tema | recomendar practica | | Concepto | vector curricular | conectar prerrequisitos | | Estudiante | vector de estado de aprendizaje | personalizar secuencia |\n\nUn embedding no es una explicacion por si mismo. Es una herramienta representacional que requiere interpretacion externa.\n\nLos modelos generativos aprenden distribuciones que permiten producir texto, imagenes, audio u otros datos. En lenguaje, un modelo generativo estima la probabilidad de una secuencia de tokens y puede generar continuaciones plausibles.\n\n$$ P(x_1, x_2, \\dots, x_n) = \\prod_{t=1}^{n} P(x_t \\mid x_1, \\dots, x_{t-1}) $$\n\nEsta descomposicion expresa que la probabilidad de una secuencia se construye token por token. En aplicaciones educativas, los modelos de lenguaje pueden apoyar explicaciones, retroalimentacion y generacion de ejercicios, pero requieren verificacion.\n\n- Pueden producir respuestas fluidas pero incorrectas. - Pueden inventar fuentes o justificar errores. - Pueden reflejar sesgos del corpus de entrenamiento. - Pueden no distinguir entre ayuda pedagogica y solucion directa. - Pueden requerir guardrails para proteger datos personales.\n\nEl uso educativo responsable exige combinar generacion con evaluacion, trazabilidad y supervision humana.", content_version: 1, created_at: "2026-07-23T03:23:38.663649+00:00", document_id: "b341b37f9a7cc7b1", document_node_id: "document:b341b37f9a7cc7b1", end_position: 458, language: "es-MX", manual: false, node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-14", node_type: "chunk", order: 14, schema_version: 1, section_node_id: "section:b341b37f9a7cc7b1:graph-section-5", source_chunk_ids: ["chunk-110", "chunk-111", "chunk-112", "chunk-113", "chunk-114", "chunk-115", "chunk-116", "chunk-117"], source_hash: "0bd9a35e697a7899d299d65d745d120ed5f514186a65dd6b0ddc54b9fa090d76", source_section_ids: ["section-39", "section-40", "section-41"], source_section_titles: ["14.1 Embeddings", "15. Modelos generativos y lenguaje", "15.1 Riesgos de modelos generativos"], start_position: 429, status: "active", title: "Probabilidad secuencia", token_count: 317, visibility: "private", word_count: 220};

MERGE (n:Chunk {node_id: "chunk:b341b37f9a7cc7b1:graph-chunk-15"})
